{
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/fpl.js": {
      "maxDuration": 30
    },
    "api/recent.js": {
      "maxDuration": 30
    },
    "api/deadline.js": {
      "maxDuration": 30,
      "includeFiles": "engine.js"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}